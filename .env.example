# ──────────────────────────────────────────
#  Dungeon AI — переменные окружения
#  Скопируй в .env и заполни свои значения
# ──────────────────────────────────────────

# База данных (Railway даёт автоматически)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — придумай любую длинную случайную строку
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Anthropic API ключ (твой sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ЮКасса (получить на yookassa.ru)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# URL сайта (для ЮКассы — куда редиректить после оплаты)
APP_URL=https://your-app.railway.app

# Порт
PORT=3000

# Стоимость токенов (рублей за 1000 токенов)
PRICE_PER_1K_TOKENS=2

# Минимальная сумма пополнения (рублей)
MIN_TOPUP=100
